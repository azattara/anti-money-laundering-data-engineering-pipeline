#!/bin/bash
set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive

fetch_secret() {
  local project_id="$1"
  local secret_name="$2"
  local token

  token=$(curl -s -H "Metadata-Flavor: Google" \
    http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token \
    | python3 -c "import json,sys; print(json.load(sys.stdin)['access_token'])")

  curl -s -H "Authorization: Bearer $${token}" \
    "https://secretmanager.googleapis.com/v1/projects/$${project_id}/secrets/$${secret_name}/versions/latest:access" \
    | python3 -c "import base64,json,sys; print(base64.b64decode(json.load(sys.stdin)['payload']['data']).decode())"
}

apt-get update
apt-get install -y ca-certificates curl docker.io python3

systemctl enable docker
systemctl start docker

mkdir -p /opt/kestra/db /opt/kestra/storage
chown -R 1000:1000 /opt/kestra/db /opt/kestra/storage || true
chmod -R 775 /opt/kestra/db /opt/kestra/storage || true

docker rm -f kestra || true

if [ "${kestra_basic_auth_enabled}" = "true" ]; then
  KESTRA_BASIC_AUTH_USERNAME=$(fetch_secret "${project_id}" "${kestra_basic_auth_username_secret}")
  KESTRA_BASIC_AUTH_PASSWORD=$(fetch_secret "${project_id}" "${kestra_basic_auth_password_secret}")
fi

cat >/tmp/kestra-config.yml <<EOF
datasources:
  h2:
    url: "jdbc:h2:/opt/kestra/db/db;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE"
    driverClassName: org.h2.Driver
    username: sa
    password: ""
kestra:
  repository:
    type: h2
  queue:
    type: h2
  storage:
    type: local
    local:
      base-path: /opt/kestra/storage
  tasks:
    tmp-dir:
      path: /tmp/kestra-wd/tmp
  server:
    basic-auth:
      enabled: false
micronaut:
  security:
    enabled: false
EOF

docker run -d \
  --name kestra \
  --restart unless-stopped \
  --user root \
  --memory 12g \
  --memory-swap 12g \
  -e JAVA_OPTS="-Xms2g -Xmx4g -XX:MaxMetaspaceSize=512m" \
  -p 8080:8080 \
  -v /opt/kestra/db:/opt/kestra/db \
  -v /opt/kestra/storage:/opt/kestra/storage \
  -v /tmp/kestra-config.yml:/etc/kestra/config.yml:ro \
  kestra/kestra:latest \
  server standalone --config /etc/kestra/config.yml