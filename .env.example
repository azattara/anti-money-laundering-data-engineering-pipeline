# ============================================================
# Anti Money Laundering Data Engineering Pipeline
# Environment Variables Example
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ---- Kaggle API Credentials ----
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# ---- GCP Configuration ----
GCP_PROJECT_ID=anti-ml-data-engineering
GCP_REGION=us-central1

# Path to your GCP service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account.json

# ---- GCS Bucket Names ----
GCS_BRONZE_BUCKET=anti-ml-data-engineering-bronze
GCS_SILVER_BUCKET=anti-ml-data-engineering-silver
GCS_ARTIFACTS_BUCKET=anti-ml-data-engineering-artifacts

# ---- BigQuery Configuration ----
BQ_BRONZE_DATASET=aml_bronze
BQ_SILVER_DATASET=aml_silver
BQ_GOLD_DATASET=aml_gold

# ---- Kaggle Dataset ----
KAGGLE_DATASET=ealtman2019/ibm-transactions-for-anti-money-laundering-aml

# ---- Kestra Configuration ----
KESTRA_PORT=8080
KESTRA_POSTGRES_USER=kestra
KESTRA_POSTGRES_PASSWORD=change_me_in_production
KESTRA_POSTGRES_DB=kestra
